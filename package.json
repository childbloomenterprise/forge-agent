{
  "name": "forge-agent",
  "displayName": "Forge Agent",
  "description": "Coding agent for VS Code whose agent loop runs on TrueForge.",
  "version": "0.1.0",
  "publisher": "childbloomenterprise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/childbloomenterprise/forge-agent"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeAgent",
          "title": "Forge Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forgeAgent": [
        {
          "type": "webview",
          "id": "forgeAgent.panel",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "forgeAgent.focus",
        "title": "Forge Agent: Open Agent Panel"
      },
      {
        "command": "forgeAgent.cancel",
        "title": "Forge Agent: Cancel Running Turn"
      },
      {
        "command": "forgeAgent.newSession",
        "title": "Forge Agent: New Session"
      },
      {
        "command": "forgeAgent.undoLastChange",
        "title": "Forge Agent: Undo Last Agent Change"
      }
    ],
    "keybindings": [
      {
        "command": "forgeAgent.cancel",
        "key": "escape",
        "when": "forgeAgent.running"
      }
    ],
    "configuration": {
      "title": "Forge Agent",
      "properties": {
        "forgeAgent.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the TrueForge server."
        },
        "forgeAgent.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "google-gemini/gemini-3-5-flash",
            "groq/qwen3-8-27b"
          ],
          "description": "Model chain (provider/model). The first is primary; the rest are automatic fallbacks."
        },
        "forgeAgent.mcpPort": {
          "type": "number",
          "default": 9317,
          "description": "Port for the extension's local MCP server (127.0.0.1)."
        },
        "forgeAgent.contextBudgetTokens": {
          "type": "number",
          "default": 12000,
          "description": "Token budget for automatically retrieved context."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test out/test/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "^0.184.1",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.90",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9"
  }
}
